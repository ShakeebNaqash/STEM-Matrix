# FastAPI base URL. Read on the server only. Do not prefix it with NEXT_PUBLIC_.
BACKEND_URL=http://127.0.0.1:8000

# Comma-separated routes that call the real backend.
# health, chat, books, sources, practice, grade, flashcards, feedback
# Use * for every route. Leave this empty to keep the mock on every route.
BACKEND_LIVE_ROUTES=

# Multiplies the mock chat delays. 8 makes Stop easy to hit by hand.
MOCK_STREAM_SLOWDOWN=1

# Mock health pill, used only while health is not in BACKEND_LIVE_ROUTES.
# ready, test_model, no_model, or offline. Leave empty for the scripted preview.
MOCK_HEALTH=
